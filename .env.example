# ======================================================================#  Solana Autonomous Bot – Konfiguration
#  Kopieren:  cp .env.example .env && chmod 600 .env
#  NIEMALS committen oder teilen! (.env steht in .gitignore)
# ======================================================================
# ---------------------------------------------------------------- Modus & Wallet
# true  = Dry-Run: echte Marktanalyse + echte Jupiter-Quotes, virtuelle Ausführung
# false = LIVE: echte Transaktionen (zusätzlich LIVE_TRADING_CONFIRMED nötig)
SIMULATION_MODE=true
# Zweite Sicherheitsverriegelung für LIVE – exakt diesen Wert eintragen:
# LIVE_TRADING_CONFIRMED=I_UNDERSTAND_THE_RISKS
LIVE_TRADING_CONFIRMED=

# Phantom: Einstellungen → Konten verwalten → Konto → "Privaten Schlüssel anzeigen" (base58)
# Alternativ Solana-CLI-Format: [12,34,...] (64 Bytes)
# EMPFEHLUNG: separate Hot-Wallet nur für den Bot mit begrenztem Guthaben!
WALLET_PRIVATE_KEY=
# Optional, aber empfohlen: Adresse zur Gegenprüfung (Start schlägt fehl, wenn sie nicht passt)
WALLET_PUBLIC_KEY=

# ---------------------------------------------------------------- RPC
# Kommagetrennt, in Prioritätsreihenfolge (bezahlter Node zuerst, public als Fallback).
# Der öffentliche Mainnet-RPC ist für Trading zu langsam und stark rate-limitiert.
RPC_ENDPOINTS=https://mainnet.helius-rpc.com/?api-key=DEIN_KEY,https://api.mainnet-beta.solana.com
RPC_COMMITMENT=confirmed
# Requests pro Sekunde je Endpoint (an deinen RPC-Plan anpassen)
RPC_MAX_RPS=10
RPC_TIMEOUT_MS=15000
RPC_HEALTH_INTERVAL_MS=30000

# ---------------------------------------------------------------- Jupiter
# lite-api.jup.ag ist abgekündigt → API-Key (kostenlos) unter https://portal.jup.ag
JUPITER_API_BASE=https://api.jup.ag/swap/v1
JUPITER_API_KEY=
# Free-Tier ≈ 1 Request/Sekunde
JUPITER_MAX_RPS=1
JUPITER_MAX_ACCOUNTS=40
# medium | high | veryHigh
PRIORITY_LEVEL=high
# Obergrenze der Priority-Fee pro Transaktion (Lamports; 300000 = 0,0003 SOL)
MAX_PRIORITY_FEE_LAMPORTS=300000

# ---------------------------------------------------------------- Ausführung
DEFAULT_SLIPPAGE_BPS=150
MAX_PRICE_IMPACT_PCT=3
# Transaktion vor dem Senden simulieren (verhindert bezahlte Fehlschläge)
PRE_SIMULATE_TX=true
TX_CONFIRM_TIMEOUT_MS=120000
# Leere Token-Konten nach dem Verkauf schließen (holt ~0,002 SOL Rent zurück)
CLOSE_EMPTY_TOKEN_ACCOUNTS=true

# ---------------------------------------------------------------- Simulation (Paper-Trading)
SIM_STARTING_BALANCE_SOL=5
# true = virtuelles Startguthaben = echtes Wallet-Guthaben
SIM_USE_WALLET_BALANCE=false
# Simulierte Latenz zwischen Quote und "Ausführung" (danach Re-Quote)
SIM_LATENCY_MS=600
# Zusätzlicher Abschlag auf jeden Fill (MEV/Konkurrenz-Puffer)
SIM_EXTRA_SLIPPAGE_BPS=20

# ---------------------------------------------------------------- Risiko (global)
RISK_MAX_POSITION_SOL=0.1
RISK_MAX_TOTAL_EXPOSURE_SOL=0.5
# Tagesverlust (UTC) → danach keine neuen Einstiege bis Mitternacht UTC
RISK_MAX_DAILY_LOSS_SOL=0.2
RISK_MAX_OPEN_POSITIONS=5
# Mindestbestand für Fees/Rent, wird nie investiert
RISK_MIN_SOL_RESERVE=0.05
# Sperre für ein Token nach Verlust-Trade (Minuten)
RISK_LOSS_COOLDOWN_MIN=120
# Circuit Breaker: nach N fehlgeschlagenen Transaktionen in Folge X Minuten Pause
RISK_MAX_CONSECUTIVE_TX_FAILURES=5
RISK_CIRCUIT_BREAKER_PAUSE_MIN=15

# ---------------------------------------------------------------- Strategie: SuckUpTheRent
SUTR_ENABLED=true
SUTR_SCAN_INTERVAL_MS=30000
SUTR_MANAGE_INTERVAL_MS=10000
# (a) Roundtrip-Mikroarbitrage (SOL→Token→SOL nur bei positivem Netto-Edge)
SUTR_ARB_ENABLED=true
SUTR_ARB_SIZE_SOL=0.05
# Mindest-Netto-Edge nach allen Fees in Basispunkten (40 = 0,4 %)
SUTR_ARB_MIN_EDGE_BPS=40
SUTR_ARB_MAX_PROBES=4
SUTR_MIN_LIQUIDITY_USD=75000
# Velocity = 1h-Volumen / Liquidität (0.3 = 30 % Umschlag pro Stunde)
SUTR_MIN_VELOCITY=0.3
SUTR_MIN_POOL_AGE_MIN=30
# (b) LP-Fee-Simulation (immer Paper, auch im LIVE-Modus)
SUTR_LP_SIM_ENABLED=true
SUTR_LP_SCAN_INTERVAL_MS=300000
SUTR_LP_SIZE_SOL=1
SUTR_LP_MAX_POSITIONS=5
SUTR_LP_MIN_TVL_USD=100000
SUTR_LP_MIN_FEE_APR=50
SUTR_LP_MAX_HOLD_MIN=720
SUTR_LP_MAX_LOSS_PCT=5
# (c) Rent-Reclaimer (LIVE: schließt leere Token-Konten; SIM: nur Bericht)
SUTR_RENT_RECLAIM_ENABLED=true
SUTR_RENT_RECLAIM_INTERVAL_MS=1800000

# ---------------------------------------------------------------- Strategie: ReversalSniper
RS_ENABLED=true
RS_SCAN_INTERVAL_MS=60000
RS_MANAGE_INTERVAL_MS=15000
RS_TRADE_SIZE_SOL=0.05
RS_MIN_LIQUIDITY_USD=40000
RS_MIN_MCAP_USD=250000
RS_MAX_MCAP_USD=100000000
RS_MIN_PAIR_AGE_HOURS=12
# Vorfilter: Kursrückgang 24h mindestens X % (oder 6h ≥ 10 %)
RS_MIN_H24_DROP_PCT=15
# Tiefenanalyse: Abstand vom 24h-Hoch mindestens X %
RS_MIN_DRAWDOWN_PCT=35
# Einstiegsschwelle des Umkehr-Scores (0–100)
RS_MIN_SCORE=65
RS_MAX_ANALYSES_PER_SCAN=5
RS_REEVALUATE_AFTER_MIN=20
# Maximaler Wash-Trading-Anteil am Volumen (0–1)
RS_MAX_WASH_RATIO=0.45
RS_SUPPORT_TOLERANCE_PCT=2.5
RS_TAKE_PROFIT_PCT=30
# Obergrenze des (dynamisch am Support gesetzten) Stop-Loss
RS_STOP_LOSS_PCT=12
RS_TRAILING_ACTIVATION_PCT=12
RS_TRAILING_STOP_PCT=8
RS_MAX_HOLD_MIN=360
# Kommagetrennte Wallet-Adressen, deren Käufe als Smart Money gewichtet werden
RS_SMART_MONEY_WALLETS=
# Kommagetrennte Token-Mints, die zusätzlich immer analysiert werden
RS_WATCHLIST=
RS_MIN_ACCUMULATION_USD=500

# ---------------------------------------------------------------- Betrieb
LOG_LEVEL=info
# pretty (Terminal) | json (Log-Aggregation)
LOG_FORMAT=pretty
LOG_COLOR=true
LOG_DIR=./logs
STATE_DIR=./data
HEARTBEAT_INTERVAL_MS=300000
TICK_TIMEOUT_MS=240000
SHUTDOWN_GRACE_MS=20000
# Shared market data (public providers; no additional keys required)
DATA_CACHE_ENABLED=true
DATA_DISCOVERY_TTL_MS=60000
DATA_ANALYSIS_TTL_MS=15000
DATA_POSITION_TTL_MS=3000
DATA_MAX_CONCURRENT=4
DATA_RETRIES=2
DATA_TIMEOUT_MS=10000
DATA_MAX_PRICE_AGE_MS=90000
DATA_MAX_CANDLE_AGE_MS=600000
DATA_DEX_RPS=1
DATA_GECKO_RPS=0.13333333333333333
DATA_RAYDIUM_RPS=1
DATA_HISTORY_ENABLED=true
DATA_RETENTION_DAYS=7
DATA_HISTORY_MAX_MB=128
# Data disagreement gates; do not change the strategy's 100-point score.
DATA_MAX_PRICE_DIFFERENCE_PCT=20
DATA_MAX_LIQUIDITY_DIFFERENCE_PCT=50
JUPITER_QUOTE_MAX_AGE_MS=15000

# ---------------------------------------------------------------- Web-Dashboard (npm run dashboard)
# Nur lokal erreichbar lassen! Auf dem VPS per SSH-Tunnel öffnen:
#   ssh -L 8787:127.0.0.1:8787 solbot@DEIN_SERVER   → http://127.0.0.1:8787
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8787
# Welche Zustandsdateien angezeigt werden (Standard: folgt SIMULATION_MODE)
DASHBOARD_MODE=

# Separate micro profile; these are budget limits, not observed wallet values.
MICRO_BUDGET_USD=5
MICRO_TRADE_USD=1
MICRO_STATE_DIR=./data-micro
