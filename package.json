{
  "name": "solana-autonomous-bot",
  "version": "1.0.0",
  "private": true,
  "description": "Modularer, autonomer Solana-Trading-Bot (SuckUpTheRent + ReversalSniper) mit Dry-Run-Modus, RPC-Failover und PM2-Deployment",
  "main": "dist/index.js",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --enable-source-maps dist/index.js",
    "dev": "tsx watch src/index.ts",
    "sim": "tsx src/index.ts --simulation",
    "test:connection": "tsx src/scripts/test-connection.ts",
    "test:connection:dist": "node --enable-source-maps dist/scripts/test-connection.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:reload": "pm2 reload ecosystem.config.js --update-env",
    "pm2:stop": "pm2 stop solana-bot",
    "pm2:logs": "pm2 logs solana-bot --lines 200",
    "dashboard": "tsx src/dashboard/server.ts",
    "dashboard:dist": "node dist/dashboard/server.js",
    "build:playbook": "tsc -p tsconfig.playbook.json",
    "sim:playbook": "node --enable-source-maps dist-playbook/strategies/reversal-sniper/playbook/runtime.js",
    "test:playbook": "node --import tsx --test tests/playbook.test.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:data": "node --import tsx --test tests/market-data.test.ts",
    "data:check": "node --import tsx src/scripts/test-market-data.ts",
    "data:replay": "node --import tsx src/scripts/replay-data.ts",
    "live:check": "node --import tsx src/scripts/live-preflight.ts",
    "micro:check": "node --import tsx src/micro/runtime.ts --check",
    "micro:sim": "node --import tsx src/micro/runtime.ts --simulation",
    "micro:live": "node --import tsx src/micro/runtime.ts --live",
    "test:micro": "node --import tsx --test tests/micro.test.ts",
    "desk:paper": "node --import tsx src/scripts/desk-paper.ts",
    "desk:replay": "node --import tsx src/scripts/desk-replay.ts",
    "desk:backtest": "node --import tsx src/scripts/desk-backtest.ts",
    "desk:golden": "node --import tsx src/scripts/desk-golden.ts",
    "test:desk": "node --import tsx --test tests/desk.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.98.0",
    "bs58": "^5.0.0",
    "dotenv": "^16.4.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
