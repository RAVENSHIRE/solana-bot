{
  "name": "solana-bot-dashboard",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "node --import tsx server/index.ts --dev",
    "build": "tsc --noEmit && vite build",
