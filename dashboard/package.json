    "test": "node --import tsx --test tests/*.test.ts",
    "schema": "node --import tsx shared/export-schema.ts"
  },
  "dependencies": {
    "@phantom/browser-sdk": "2.0.3",
    "@solana/web3.js": "1.98.4",
    "@tailwindcss/vite": "^4.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "buffer": "6.0.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "vite": "^6.1.0",
    "zod": "^3.24.2",
    "zod-to-json-schema": "^3.24.3"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "axios": "1.18.0"
  }
